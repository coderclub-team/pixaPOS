{
  "name": "pixaPOS",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "pnpm -w exec oxlint --fix . && pnpm -w exec oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml' '!apps/template/.agents/**' '!apps/template/.claude/**'",
    "format": "pnpm -w exec oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml' '!apps/template/.agents/**' '!apps/template/.claude/**'",
    "format:check": "pnpm -w exec oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml' '!apps/template/.agents/**' '!apps/template/.claude/**'",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @pixa/web dev",
    "dev:admin": "pnpm --filter @pixa/admin dev",
    "dev:mobile": "pnpm --filter @pixa/mobile dev",
    "dev:template": "pnpm --filter @pixa/template dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@neon/functions": "^0.11.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "5.7.2"
  },
  "lint-staged": {
    "!(scripts)/**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
