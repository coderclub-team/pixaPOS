{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm build --filter @pixa/web",
  "outputDirectory": ".next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "regions": ["bom1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "release/*": true
    }
  },
  "github": {
    "silent": true
  }
}
