# pixaPOS environment tiers: dev → stage → prod.
# Copy per tier; never commit real values (.env* is gitignored).
# Promotion order for migrations: dev → stage → prod (never prod first).

# Tier selector — dev | stage | prod
APP_ENV=dev

# Neon Postgres, pooled per-branch connection string
#   dev:   main branch endpoint
#   stage: stage branch endpoint (branched from prod)
#   prod:  prod branch endpoint
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Better Auth (per-tier secret + public origin)
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (test client on dev/stage, prod client on prod)
# Redirect URIs per origin: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (TEST keys on dev/stage, LIVE keys on prod only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_PLAN_ID=plan_...
# RAZORPAY_WEBHOOK_SECRET=

# KDS live feed (Neon Function per tier — URL + shared secret must match)
#   dev:   https://<dev-branch>-kdsfeed.compute.<cell>.aws.neon.tech
#   stage: https://br-still-firefly-b3ksnzlc-kdsfeed.compute.c-4.ap-southeast-1.aws.neon.tech
#   prod:  https://br-rough-shape-b37awfnj-kdsfeed.compute.c-4.ap-southeast-1.aws.neon.tech
NEXT_PUBLIC_KDS_FEED_URL=
NEXT_PUBLIC_KDS_FEED_SECRET=

# Neon Object Storage (branch-scoped S3 creds via `neon env pull`)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Bucket name override for legacy presigned reads (new uploads go to the
# public-read outlet-assets bucket and return durable URLs)
# PIXA_IMAGE_BUCKET=menu-images

# Google Maps Platform (Places + Geocoding for customer/outlet address maps)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sync engine (both off until pilot cutover)
# PIXA_SYNC_ENABLED=false

# DANGER: local dev only. Must never be true on stage/prod (env.ts enforces).
# NEXT_PUBLIC_PIXAPOS_DEV_BYPASS=true
